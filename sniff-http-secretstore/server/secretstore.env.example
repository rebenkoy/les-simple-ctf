# Documents the env this server expects. Normally you don't fill this in: `just challenge
# sniff-secretstore` injects FLAG + ADMIN_PASS from the single store (infra/web/challenges.toml).
# Set them here only if you run `docker compose` directly (wire up as an env_file).
# FLAG must match the `flag`, and ADMIN_PASS the `admin_pass`, of the sniff tile in challenges.toml.
FLAG=
ADMIN_USER=admin
ADMIN_PASS=
